{
  "_comment": "Maps source export files to SETU tables. To connect a real export: copy this file, change the file names, column names, time format and code lists to match it; no code changes needed. Columns are source names; the keys are SETU fields.",
  "time_format": "%Y-%m-%d %H:%M",
  "sources": {
    "masters/bases.csv": {"system": "master", "table": "bases",
      "columns": {"base": "BASE", "env": "ENV_CLASS"}},
    "masters/fleets.csv": {"system": "master", "table": "fleets",
      "columns": {"fleet": "TYPE", "role": "ROLE", "fh_per_day": "FH_PER_DAY", "inspection_interval_fh": "INSP_INTERVAL_FH",
                  "inspection_days": "INSP_DAYS", "mttr_fail_days": "MTTR_FAIL_DAYS", "mttr_swap_days": "MTTR_SWAP_DAYS",
                  "role_weight": "ROLE_WEIGHT", "squadron_ue": "SQN_UE"}},
    "masters/aircraft.csv": {"system": "master", "table": "aircraft",
      "columns": {"tail": "TAIL", "fleet": "TYPE", "base": "BASE"}},
    "masters/agencies.csv": {"system": "master", "table": "agencies",
      "columns": {"agency": "AGENCY", "kind": "KIND", "country": "COUNTRY"}},
    "masters/parts.csv": {"system": "master", "table": "parts",
      "columns": {"pn": "PARTNO", "name": "NOMENCLATURE", "family": "SYSTEM", "fleet": "TYPE", "positions": "POSITIONS",
                  "origin": "ORIGIN", "eligible_agencies": "APPROVED_AGENCIES", "default_agency": "DEFAULT_AGENCY",
                  "unit_cost_lakh": "UNIT_COST_LAKH", "procurement_days": "LEAD_DAYS"},
      "lists": {"eligible_agencies": ";"}},
    "emms/installs.csv": {"system": "e-MMS", "table": "installs",
      "columns": {"serial": "SERIALNUM", "pn": "ITEMNUM", "tail": "ASSETNUM", "position": "POSITION",
                  "install_time": "INSTALLDATE", "install_hours": "INSTALL_TSR",
                  "removal_time": "REMOVEDATE", "removal_hours": "REMOVE_TSR", "removal_reason": "REMOVECODE",
                  "current_hours": "CURRENT_TSR"},
      "codes": {"removal_reason": {"FAIL": "failure", "PREV": "preventive", "CANN": "cannibalised", "": null}}},
    "emms/repair_orders.csv": {"system": "e-MMS", "table": "repair_orders",
      "columns": {"order_no": "WONUM", "serial": "SERIALNUM", "pn": "ITEMNUM", "agency": "VENDOR", "from_base": "FROMSITE",
                  "sent_time": "SENTDATE", "start_time": "ACTSTART", "done_time": "ACTFINISH", "work_type": "WORKTYPE",
                  "hours_at_induction": "TSR"},
      "codes": {"work_type": {"REP": "REPAIR", "OH": "OVERHAUL", "DEEP": "DEEP"}}},
    "emms/defects.csv": {"system": "e-MMS", "table": "defects",
      "columns": {"ticket": "TICKETID", "report_time": "REPORTDATE", "tail": "ASSETNUM", "pn": "ITEMNUM",
                  "serial": "SERIALNUM", "problem_code": "PROBLEMCODE", "description": "DESCRIPTION"}},
    "immols/receipts.csv": {"system": "IMMOLS", "table": "receipts",
      "columns": {"receipt_time": "RECEIPTDATE", "base": "DEPOT", "pn": "PARTNO", "serial": "SERIALNO", "source": "SOURCE"},
      "codes": {"source": {"REPAIR": "repair", "NEW": "new", "TRANSFER": "transfer", "LATERAL": "lateral"}}},
    "immols/onhand.csv": {"system": "IMMOLS", "table": "onhand",
      "columns": {"as_of": "ASOFDATE", "base": "DEPOT", "pn": "PARTNO", "serial": "SERIALNO"}}
  }
}
